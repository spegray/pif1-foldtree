# =============================================================================
# pif1-foldtree .gitignore
# Philosophy: commit the auditable pipeline (code, manifest, small seqs, docs,
# final trees/logs). EXCLUDE bulky data that any script can regenerate, so the
# repo stays small and clones fast onto the Windows/WSL2 folding box.
# =============================================================================

# --- Regenerable / bulky structure data --------------------------------------
# AFDB cache: ~569 MB; re-fetch any time with workflow/03_fetch_structures.py
data/structures/afdb/
# Corecut structure slices: regenerated from afdb/ + af3/ at Stage 3
data/structures/cores/
# Folded gap predictions (Stage 2b output): produced on the 4090, transferred
# back out-of-band (scp/rsync). Provenance is recorded in manifest.csv.
data/structures/af3/*.pdb
data/structures/af3/*.cif
# ...but DO keep the gap input FASTA and the how-to that belong in git:
!data/structures/af3/to_predict_129.faa
!data/structures/af3/*.md

# --- Whole reference proteomes (huge, regenerable from UniProt) ---------------
data/proteomes/

# --- Heavy phylogenetics intermediates (final .treefile/.iqtree/.log kept) ----
*.ckp.gz
*.uniqueseq.phy
*.splits.nex

# --- OS / editor / Python cruft ----------------------------------------------
.DS_Store
__pycache__/
*.pyc
*.swp
# Microsoft Office lock/owner files (e.g. ~$deck.pptx) - transient, never commit
~$*

# --- ColabFold run intermediates & accidental installs (regenerable; never commit) ---
data/structures/af3/out/
data/structures/af3/out_cores/
data/structures/af3/out_smoketest/
data/structures/af3/_*.faa
data/structures/af3/to_predict_129.clean.faa
/localcolabfold/
/install_colabbatch_linux.sh
/out/
/to_predict_129.clean.faa

# --- Large regenerable reconciliation/structural-search intermediates ---
results/struct_tree/res.m8
results/struct_tree/tmp/
data/3di/coresdb*
taxdump.tar.gz
tools/
*.ufboot
*.mldist
*.bionj
results/struct_tree/*_distmat.phy

# --- 238-structure expansion check (results/expansion/) ----------------------
# Keep the auditable record: EXPANSION238_CHECK.md, keep223.txt, q223.list,
# mafft.log + the small input seqs in data/expansion238/. Ignore the bulky,
# fully-regenerable foldseek query DB, raw result shards, MAFFT --add alignment,
# and the 6.7 MB hits table (reproduce from the seqs + coresdb per the .md).
results/expansion/aln1180.fasta
results/expansion/hits.m8
results/expansion/q223db*
results/expansion/res.*
results/expansion/tmp/

# Claude Code local settings
.claude/settings.local.json

# Large, regenerable AF3 intermediates — archive externally (Zenodo/Drive), link in README
data/g4_models/**/msas/
data/g4_models/**/templates/
data/g4_models/**/*full_data*.json
data/*.zip

# --- Cross-machine transfer archives + R cruft (keep the EXTRACTED files, not the archive) ---
*.tar.gz
data/species_tree/*.zip
.Rhistory

# --- Verbose recPhyloXML (~3 MB each; the compact .nhx alongside holds the same reconciliation) ---
results/reconciliation/**/*_reconciliated.xml
# ...but keep the authoritative grafted-run recPhyloXML - Fig S4 (thirdkind) reproduces from it:
!results/reconciliation/aa3di_grafted/run/reconciliations/pif1_reconciliated.xml
# IQ-TREE ancestral-state posteriors (large; regenerate with workflow/19)
*.state
